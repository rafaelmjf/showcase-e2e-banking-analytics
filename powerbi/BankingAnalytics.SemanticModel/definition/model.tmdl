model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Date","Bank","Reporting Line","COSIF Account","Document","Macro Series","Source File","Reporting Line Balance","Account Balance","Monthly Economic Context","Account Reporting Line","WarehouseServer","WarehouseDatabase"]

ref table Date
ref table Bank
ref table 'Reporting Line'
ref table 'COSIF Account'
ref table Document
ref table 'Macro Series'
ref table 'Source File'
ref table 'Reporting Line Balance'
ref table 'Account Balance'
ref table 'Monthly Economic Context'
ref table 'Account Reporting Line'

