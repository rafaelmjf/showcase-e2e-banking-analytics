	partition 'Macro Series' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(WarehouseServer, WarehouseDatabase),
				    Data = Source{[Schema="analytics_marts",Item="dim_macro_series"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

