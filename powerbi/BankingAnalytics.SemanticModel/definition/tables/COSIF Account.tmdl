/// One row per COSIF account code observed in the selected source files. Used for
/// account-level drill-through. COSIF codes are hierarchical, so a parent account
/// already contains its children: never sum this dimension across levels.
table 'COSIF Account'
	lineageTag: 2b3c4d5e-0500-4000-8000-000000000500

	column account_key
		dataType: string
		isHidden
		isKey
		lineageTag: 2b3c4d5e-0501-4000-8000-000000000501
		summarizeBy: none
		sourceColumn: account_key

		annotation SummarizationSetBy = Automatic

	/// COSIF account code.
	column 'Account Code'
		dataType: string
		lineageTag: 2b3c4d5e-0502-4000-8000-000000000502
		summarizeBy: none
		sourceColumn: account_code

		annotation SummarizationSetBy = Automatic

	/// COSIF account description.
	column 'Account Name'
		dataType: string
		lineageTag: 2b3c4d5e-0503-4000-8000-000000000503
		summarizeBy: none
		sourceColumn: account_name

		annotation SummarizationSetBy = Automatic

	column Taxonomy
		dataType: string
		lineageTag: 2b3c4d5e-0504-4000-8000-000000000504
		summarizeBy: none
		sourceColumn: taxonomy

		annotation SummarizationSetBy = Automatic

	/// Top-level COSIF class digit.
	column 'Account Class'
		dataType: string
		lineageTag: 2b3c4d5e-0505-4000-8000-000000000505
		summarizeBy: none
		sourceColumn: account_class

		annotation SummarizationSetBy = Automatic

	column 'Account Group'
		dataType: string
		lineageTag: 2b3c4d5e-0506-4000-8000-000000000506
		summarizeBy: none
		sourceColumn: account_group

		annotation SummarizationSetBy = Automatic

	/// True where this account is one of the seven mapped reporting-line components.
	column 'Is Reporting-Line Component'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2b3c4d5e-0507-4000-8000-000000000507
		summarizeBy: none
		sourceColumn: is_reporting_line_component

		annotation SummarizationSetBy = Automatic

	column is_fixture
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2b3c4d5e-0508-4000-8000-000000000508
		summarizeBy: none
		sourceColumn: is_fixture

		annotation SummarizationSetBy = Automatic

	partition 'COSIF Account' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(WarehouseServer, WarehouseDatabase),
				    Data = Source{[Schema="analytics_marts",Item="dim_cosif_account"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

