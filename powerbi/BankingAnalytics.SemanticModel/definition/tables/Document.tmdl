/// Governed COSIF document codes. Monthly document 4010 is analytical; semiannual
/// 4016 is retained as excluded evidence. A disconnected reference table: all
/// analytical facts are 4010 only.
table Document
	lineageTag: 2b3c4d5e-0600-4000-8000-000000000600

	column 'Document Code'
		dataType: string
		isKey
		lineageTag: 2b3c4d5e-0601-4000-8000-000000000601
		summarizeBy: none
		sourceColumn: document_code

		annotation SummarizationSetBy = Automatic

	column 'Document Name'
		dataType: string
		lineageTag: 2b3c4d5e-0602-4000-8000-000000000602
		summarizeBy: none
		sourceColumn: document_name

		annotation SummarizationSetBy = Automatic

	/// True where the document may be used for analytical balances (4010 only).
	column 'Analytical Allowed'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2b3c4d5e-0603-4000-8000-000000000603
		summarizeBy: none
		sourceColumn: analytical_allowed

		annotation SummarizationSetBy = Automatic

	column 'Source Frequency'
		dataType: string
		lineageTag: 2b3c4d5e-0604-4000-8000-000000000604
		summarizeBy: none
		sourceColumn: source_frequency

		annotation SummarizationSetBy = Automatic

	partition Document = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(WarehouseServer, WarehouseDatabase),
				    Data = Source{[Schema="analytics_marts",Item="dim_document"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

