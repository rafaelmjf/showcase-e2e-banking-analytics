		sourceColumn: source_file_key

		annotation SummarizationSetBy = Automatic

	column report_month
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 2b3c4d5e-0806-4000-8000-000000000806
		summarizeBy: none
		sourceColumn: report_month

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column document_code
		dataType: string
		isHidden
