		sourceColumn: document_code

		annotation SummarizationSetBy = Automatic

	column institution_cnpj
		dataType: string
		isHidden
		lineageTag: 2b3c4d5e-0808-4000-8000-000000000808
		summarizeBy: none
		sourceColumn: institution_cnpj

		annotation SummarizationSetBy = Automatic

	column reporting_line_code
		dataType: string
		isHidden
		lineageTag: 2b3c4d5e-0809-4000-8000-000000000809
		summarizeBy: none
		sourceColumn: reporting_line_code

		annotation SummarizationSetBy = Automatic

	column mapping_version
		dataType: string
		isHidden
		lineageTag: 2b3c4d5e-080a-4000-8000-00000000080a
		summarizeBy: none
		sourceColumn: mapping_version

		annotation SummarizationSetBy = Automatic

	/// Hidden: exposed through the balance measures. Equals the reported sum times the
	/// presentation multiplier (currently 1).
	column presentation_balance_amount
		dataType: double
		isHidden
		lineageTag: 2b3c4d5e-080b-4000-8000-00000000080b
		summarizeBy: sum
		sourceColumn: presentation_balance_amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Hidden: the raw reported sum before any sign convention. Reconciliation only.
	column reported_balance_amount
		dataType: double
		isHidden
		lineageTag: 2b3c4d5e-080c-4000-8000-00000000080c
		summarizeBy: sum
		sourceColumn: reported_balance_amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// How many source accounts contributed to this reporting-line balance.
	column 'Contributing Accounts'
		dataType: int64
		formatString: #,0
		lineageTag: 2b3c4d5e-080d-4000-8000-00000000080d
		summarizeBy: none
		sourceColumn: contributing_account_count

		annotation SummarizationSetBy = Automatic

	/// Pipe-separated list of the source account codes that make up this line.
	column 'Contributing Account Codes'
		dataType: string
		lineageTag: 2b3c4d5e-080e-4000-8000-00000000080e
		summarizeBy: none
		sourceColumn: contributing_account_codes

		annotation SummarizationSetBy = Automatic

	column is_fixture
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 2b3c4d5e-080f-4000-8000-00000000080f
