		summarizeBy: none
		sourceColumn: bank_key

		annotation SummarizationSetBy = Automatic

	column month_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2b3c4d5e-0803-4000-8000-000000000803
		summarizeBy: none
		sourceColumn: month_key

		annotation SummarizationSetBy = Automatic

	column reporting_line_key
		dataType: string
		isHidden
		lineageTag: 2b3c4d5e-0804-4000-8000-000000000804
		summarizeBy: none
		sourceColumn: reporting_line_key

		annotation SummarizationSetBy = Automatic

	column source_file_key
		dataType: string
		isHidden
		lineageTag: 2b3c4d5e-0805-4000-8000-000000000805
