		annotation SummarizationSetBy = Automatic

	partition 'Reporting Line Balance' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(WarehouseServer, WarehouseDatabase),
				    Data = Source{[Schema="analytics_marts",Item="fact_reporting_line_balance"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

